#!/bin/sh
set -u

BUNDLE=/opt/nextgen/provision
ARM_MARKER=/etc/nextgen-provision-armed
TMP=/tmp/nextgen-provision
UBOOT_TRAILER_OFFSET=$((0x137ff0))
LOG_FILE="${NEXTGEN_BRINGUP_LOG:-}"

append_log()
{
    [ -z "$LOG_FILE" ] || printf '%s\n' "$1" >> "$LOG_FILE"
}

log()
{
    message="BRINGUP: $*"
    echo "$message"
    append_log "$message"
}

not_armed()
{
    log "production storage preflight passed; programming is not armed in this build"
    return 64
}

fail()
{
    message="BRINGUP: storage provisioning failed: $*"
    echo "$message" >&2
    append_log "$message"
    return 1
}

mtd_by_label()
{
    label="$1"
    line="$(grep " \"$label\"$" /proc/mtd 2>/dev/null | head -n 1)"
    [ -n "$line" ] || return 1
    name="${line%%:*}"
    dev="/dev/$name"
    [ -c "$dev" ] || {
        fail "$label resolves to $dev but the character device is missing"
        return 1
    }
    printf '%s\n' "$dev"
}

require_bringup_environment()
{
    [ "$(id -u)" -eq 0 ] || {
        fail "storage provisioning must run as root"
        return 1
    }

    cmdline="$(cat /proc/cmdline 2>/dev/null || true)"
    case " $cmdline " in
        *" nextgen.env=bringup "*) ;;
        *)
            fail "destructive provisioning is allowed only from the bring-up SD environment"
            return 1
            ;;
    esac
}

mtd_size_hex()
{
    label="$1"
    line="$(grep " \"$label\"$" /proc/mtd 2>/dev/null | head -n 1)"
    [ -n "$line" ] || return 1
    set -- $line
    printf '%s\n' "$2"
}

require_mtd_size()
{
    label="$1"
    expected="$2"
    got="$(mtd_size_hex "$label")" || {
        fail "missing MTD partition: $label"
        return 1
    }
    [ "$((0x$got))" -eq "$((expected))" ] || {
        fail "$label size mismatch: 0x$got != $(printf '0x%x' "$expected")"
        return 1
    }
}

hash_file()
{
    sha256sum "$1" | awk '{print $1}'
}

verify_readback()
{
    dev="$1"
    offset="$2"
    source="$3"
    name="$4"
    bytes="$(wc -c < "$source" | tr -d '[:space:]')"
    out="$TMP/$name.readback"

    rm -f "$out"
    mtd_debug read "$dev" "$offset" "$bytes" "$out" >/dev/null || {
        fail "could not read back $name"
        return 1
    }

    [ "$(hash_file "$source")" = "$(hash_file "$out")" ] || {
        fail "$name readback hash mismatch"
        return 1
    }
}

find_ubi_for_mtd()
{
    mtddev="$1"
    mtdnum="${mtddev#/dev/mtd}"
    for p in /sys/class/ubi/ubi[0-9]*
    do
        [ -f "$p/mtd_num" ] || continue
        [ "$(cat "$p/mtd_num")" = "$mtdnum" ] || continue
        basename "$p"
        return 0
    done
    return 1
}

verify_volume_name()
{
    ubidev="$1"
    id="$2"
    expected="$3"
    path="/sys/class/ubi/${ubidev}_$id/name"

    [ -r "$path" ] && [ "$(cat "$path")" = "$expected" ] || {
        fail "$ubidev volume $id is not '$expected'"
        return 1
    }
}

read_volume_fully()
{
    ubidev="$1"
    id="$2"
    dev="/dev/${ubidev}_$id"

    [ -c "$dev" ] || {
        fail "missing UBI volume device $dev"
        return 1
    }

    # Static-volume reads exercise UBI's per-LEB integrity checks.
    dd if="$dev" of=/dev/null bs=131072 >/dev/null 2>&1 || {
        fail "could not read UBI volume $dev"
        return 1
    }
}

verify_rootfs_ubi()
{
    rootdev="$1"
    product="$2"
    mountpoint="$TMP/persist"

    ubiattach -p "$rootdev" >/dev/null || {
        fail "could not attach programmed rootfs UBI"
        return 1
    }

    ubidev="$(find_ubi_for_mtd "$rootdev")" || {
        fail "could not identify attached rootfs UBI device"
        ubidetach -p "$rootdev" >/dev/null 2>&1 || true
        return 1
    }

    rc=0
    verify_volume_name "$ubidev" 0 system || rc=1
    verify_volume_name "$ubidev" 1 persist || rc=1
    [ "$rc" -eq 0 ] && read_volume_fully "$ubidev" 0 || rc=1

    mkdir -p "$mountpoint"
    if [ "$rc" -eq 0 ]; then
        mount -t ubifs "$ubidev:persist" "$mountpoint" || rc=1
    fi

    if [ "$rc" -eq 0 ]; then
        [ -s "$mountpoint/app/$product/slotA.sqfs" ] || rc=1
        [ -s "$mountpoint/app/$product/slotA.meta" ] || rc=1
        [ -r "$mountpoint/state/$product/accepted" ] || rc=1
        accepted="$(cat "$mountpoint/state/$product/accepted" 2>/dev/null || true)"
        case "$accepted" in
            "slotA "*) ;;
            *) rc=1 ;;
        esac
    fi

    if awk -v p="$mountpoint" '$2 == p { found=1 } END { exit found ? 0 : 1 }' /proc/mounts; then
        umount "$mountpoint" || rc=1
    fi
    ubidetach -p "$rootdev" >/dev/null || rc=1

    [ "$rc" -eq 0 ] || {
        fail "programmed system/persist UBI failed verification"
        return 1
    }
}

verify_boot_ubi()
{
    bootdev="$1"

    ubiattach -p "$bootdev" >/dev/null || {
        fail "could not attach programmed boot UBI"
        return 1
    }

    ubidev="$(find_ubi_for_mtd "$bootdev")" || {
        fail "could not identify attached boot UBI device"
        ubidetach -p "$bootdev" >/dev/null 2>&1 || true
        return 1
    }

    rc=0
    verify_volume_name "$ubidev" 0 device-tree || rc=1
    verify_volume_name "$ubidev" 1 kernel || rc=1
    [ "$rc" -eq 0 ] && read_volume_fully "$ubidev" 0 || rc=1
    [ "$rc" -eq 0 ] && read_volume_fully "$ubidev" 1 || rc=1
    ubidetach -p "$bootdev" >/dev/null || rc=1

    [ "$rc" -eq 0 ] || {
        fail "programmed boot UBI failed verification"
        return 1
    }
}

main()
{
    for cmd in id sha256sum awk grep head wc tr dd cat flash_erase mtd_debug \
               ubiformat ubiattach ubidetach mount umount
    do
        command -v "$cmd" >/dev/null 2>&1 || {
            fail "required command is unavailable: $cmd"
            return 1
        }
    done

    [ -d "$BUNDLE" ] || {
        fail "production provisioning bundle is missing"
        return 1
    }
    [ -r "$BUNDLE/manifest.sha256" ] || {
        fail "production provisioning manifest is missing"
        return 1
    }

    (
        cd "$BUNDLE" &&
        sha256sum -c manifest.sha256
    ) >/dev/null || {
        fail "production provisioning bundle hash verification failed"
        return 1
    }

    . "$BUNDLE/layout.env"
    [ "${NEXTGEN_PROVISION_BUNDLE:-}" = 1 ] ||
        { fail "invalid provisioning bundle metadata"; return 1; }
    [ "${NEXTGEN_STORAGE_SCHEMA:-}" = ro-persist-v1 ] ||
        { fail "unexpected production storage schema"; return 1; }
    [ "${NEXTGEN_STORAGE_BACKEND:-}" = nand-ubi ] ||
        { fail "unexpected production storage backend"; return 1; }
    case "${NEXTGEN_PRODUCT:-}" in sound|vibra) ;; *)
        fail "invalid production product"; return 1 ;;
    esac
    log "validated production bundle: product=$NEXTGEN_PRODUCT backend=$NEXTGEN_STORAGE_BACKEND schema=$NEXTGEN_STORAGE_SCHEMA"

    require_mtd_size at91bootstrap "$((0x00008000))" || return 1
    require_mtd_size uboot "$((0x00138000))" || return 1
    require_mtd_size uboot-env "$((0x00020000))" || return 1
    require_mtd_size boot "$((0x00880000))" || return 1
    require_mtd_size rootfs "$((0x08000000))" || return 1

    [ "${NOR_UBOOT_TRAILER_OFFSET:-}" = 0x00137ff0 ] || {
        fail "unexpected U-Boot trailer offset in bundle"
        return 1
    }

    at91dev="$(mtd_by_label at91bootstrap)" || return 1
    ubootdev="$(mtd_by_label uboot)" || return 1
    envdev="$(mtd_by_label uboot-env)" || return 1
    bootdev="$(mtd_by_label boot)" || return 1
    rootdev="$(mtd_by_label rootfs)" || return 1

    # Finish every non-destructive check before consulting the arming marker.
    # A normal service card therefore proves its embedded bundle, target MTD
    # layout and boot context even though it cannot modify flash.
    require_bringup_environment || return 1

    arm_value="$(cat "$ARM_MARKER" 2>/dev/null || true)"
    [ "$arm_value" = "hardware-tested-nor-ubi-v1" ] || {
        not_armed
        return $?
    }

    rm -rf "$TMP"
    mkdir -p "$TMP"

    # Program and verify NAND before touching NOR. The currently installed boot
    # chain and the service SD card remain recoverable until both UBI devices
    # have been validated.
    log "formatting production system/persist UBI"
    ubidetach -p "$rootdev" >/dev/null 2>&1 || true
    ubiformat "$rootdev" -y -f "$BUNDLE/rootfs.ubi" || {
        fail "ubiformat failed for rootfs"
        return 1
    }
    verify_rootfs_ubi "$rootdev" "$NEXTGEN_PRODUCT" || return 1

    log "formatting production boot UBI"
    ubidetach -p "$bootdev" >/dev/null 2>&1 || true
    ubiformat "$bootdev" -y -f "$BUNDLE/boot.ubi" || {
        fail "ubiformat failed for boot"
        return 1
    }
    verify_boot_ubi "$bootdev" || return 1

    # Replace U-Boot before bootstrap. U-Boot is deliberately <= 0xA0000 so
    # the old fixed-window bootstrap can still load it if power disappears
    # before the trailer-aware bootstrap is written.
    log "programming NOR U-Boot"
    flash_erase "$ubootdev" 0 0 >/dev/null || {
        fail "could not erase U-Boot partition"
        return 1
    }
    uboot_bytes="$(wc -c < "$BUNDLE/u-boot.bin" | tr -d '[:space:]')"
    [ "$uboot_bytes" -le $((0x0a0000)) ] || {
        fail "U-Boot exceeds migration-safe 640 KiB window"
        return 1
    }
    mtd_debug write "$ubootdev" 0 "$uboot_bytes" "$BUNDLE/u-boot.bin" >/dev/null || {
        fail "could not program U-Boot"
        return 1
    }
    mtd_debug write "$ubootdev" "$UBOOT_TRAILER_OFFSET" 16 "$BUNDLE/u-boot.trailer" >/dev/null || {
        fail "could not program U-Boot length trailer"
        return 1
    }
    verify_readback "$ubootdev" 0 "$BUNDLE/u-boot.bin" u-boot || return 1
    verify_readback "$ubootdev" "$UBOOT_TRAILER_OFFSET" "$BUNDLE/u-boot.trailer" u-boot-trailer || return 1

    # Compiled production defaults are authoritative for the new baseline.
    log "erasing NOR U-Boot environment"
    flash_erase "$envdev" 0 0 >/dev/null || {
        fail "could not erase U-Boot environment"
        return 1
    }

    # Bootstrap is last: after this write ROM selects the new NOR boot chain.
    log "programming NOR AT91Bootstrap"
    flash_erase "$at91dev" 0 0 >/dev/null || {
        fail "could not erase AT91Bootstrap partition"
        return 1
    }
    at91_bytes="$(wc -c < "$BUNDLE/at91bootstrap.bin" | tr -d '[:space:]')"
    [ "$at91_bytes" -le $((0x8000)) ] || {
        fail "AT91Bootstrap exceeds 32 KiB partition"
        return 1
    }
    mtd_debug write "$at91dev" 0 "$at91_bytes" "$BUNDLE/at91bootstrap.bin" >/dev/null || {
        fail "could not program AT91Bootstrap"
        return 1
    }
    verify_readback "$at91dev" 0 "$BUNDLE/at91bootstrap.bin" at91bootstrap || return 1

    sync
    log "production storage programming and readback verification complete"
    return 0
}

main
exit $?
