#!/bin/sh

APP="/root/startup.sh"

WATCHDOG_PIDFILE="/run/nextgen-watchdog.pid"
APP_PIDFILE="/run/nextgen-app.pid"
STOPFILE="/run/nextgen.stop"

start()
{
    # The normal network init script only brought up loopback. Do that
    # directly here so local sockets are available before the application
    # without running ifupdown during the UI-critical startup window.
    ifconfig lo 127.0.0.1 up 2>/dev/null || true

    if [ -f "$WATCHDOG_PIDFILE" ]; then
        PID=$(cat "$WATCHDOG_PIDFILE")
        if [ -d "/proc/$PID" ]; then
            echo "NextGen already running"
            return 0
        fi
        rm -f "$WATCHDOG_PIDFILE"
    fi

    rm -f "$STOPFILE"
    rm -f "$APP_PIDFILE"

    (
        trap "exit 0" TERM INT

        while true
        do
            [ -f "$STOPFILE" ] && exit 0

            "$APP" &
            APPPID=$!
            echo "$APPPID" > "$APP_PIDFILE"

            wait "$APPPID"
            RET=$?

            rm -f "$APP_PIDFILE"

            [ -f "$STOPFILE" ] && exit 0
	    if [ "$RET" -eq 100 ]; then
    		echo "NextGen requested watchdog shutdown"
    		exit 0
	    fi
            echo "NextGen exited ($RET), restarting..."
            sleep 1
        done
    ) &

    echo $! > "$WATCHDOG_PIDFILE"
    echo "Started watchdog PID $(cat "$WATCHDOG_PIDFILE")"
}

stop()
{
    echo "Stopping NextGen"

    touch "$STOPFILE"

    if [ -f "$APP_PIDFILE" ]; then
        APPPID=$(cat "$APP_PIDFILE")

        kill "$APPPID" 2>/dev/null
        sleep 1
        kill -9 "$APPPID" 2>/dev/null

        rm -f "$APP_PIDFILE"
    fi

    if [ -f "$WATCHDOG_PIDFILE" ]; then
        PID=$(cat "$WATCHDOG_PIDFILE")

        kill "$PID" 2>/dev/null
        sleep 1
        kill -9 "$PID" 2>/dev/null

        rm -f "$WATCHDOG_PIDFILE"
    fi
}

restart()
{
    stop
    sleep 1
    start
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart)
        restart
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac

exit 0

