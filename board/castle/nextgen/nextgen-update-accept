#!/bin/sh
set -eu

[ "$#" -eq 1 ] || exit 2
PRODUCT="$1"
case "$PRODUCT" in sound|vibra) ;; *) exit 2 ;; esac

ROOT=/opt/nextgen
APP_ROOT="$ROOT/app/$PRODUCT"
STATE_ROOT="$ROOT/state/$PRODUCT"
PENDING="$STATE_ROOT/pending"
BOOTING="$STATE_ROOT/booting"
ACCEPTED="$STATE_ROOT/accepted"
ROLLBACK="$STATE_ROOT/rollback"
CLEANUP="$STATE_ROOT/cleanup"

slot_version()
{
    case "$1" in slotA|slotB|factory) ;; *) return 1 ;; esac
    slot_info="$APP_ROOT/$1/bundle.info"
    [ -r "$slot_info" ] || return 1
    [ "$(sed -n 's/^format=//p' "$slot_info")" = 3 ] || return 1
    [ "$(sed -n 's/^product=//p' "$slot_info")" = "$PRODUCT" ] || return 1
    slot_meta_version="$(sed -n 's/^version=//p' "$slot_info")"
    case "$slot_meta_version" in ''|*[!0-9]*) return 1 ;; esac
    [ "$slot_meta_version" -gt 0 ] &&
        [ "$slot_meta_version" -le 2147483647 ] || return 1
    printf '%s\n' "$slot_meta_version"
}

slot_app_valid()
{
    case "$1" in slotA|slotB|factory) ;; *) return 1 ;; esac
    slot_version "$1" >/dev/null 2>&1 &&
    [ -x "$APP_ROOT/$1/NextGen" ] &&
    [ -r "$APP_ROOT/$1/Translations.csv" ] &&
    { [ "$PRODUCT" != sound ] || [ -r "$APP_ROOT/$1/BaseHPD/hpdc.csv" ]; }
}

sdcard_mounted()
{
    grep -qs ' /sdcard ' /proc/mounts
}

cleanup_download()
{
    outcome="$1"

    [ -f "$CLEANUP" ] || {
        [ "$outcome" != rollback ] || rm -f "$ROLLBACK"
        return 0
    }

    cleanup_version=
    package=
    extra=
    IFS=' ' read -r cleanup_version package extra < "$CLEANUP" || return 1
    case "$cleanup_version" in ''|*[!0-9]*) return 1 ;; esac
    [ "$cleanup_version" -gt 0 ] &&
        [ "$cleanup_version" -le 2147483647 ] || return 1
    [ -n "$package" ] && [ -z "$extra" ] || return 1

    package_dir="${package%/*}"
    package_name="${package##*/}"
    case "$package_dir" in
        /sdcard/public|/sdcard/temp/TempFirmware) ;;
        *) return 1 ;;
    esac
    case "$package_name" in
        ''|*[!A-Za-z0-9_.-]*|*.part) return 1 ;;
    esac

    # The Application calls this helper after FileInitFileSystem(), but a card
    # can legitimately be missing. Never consume cleanup state against the
    # empty /sdcard mountpoint; retain it for the next boot with the card.
    sdcard_mounted || return 1

    if [ "$outcome" = accepted ]; then
        rm -f "$package" || return 1
        if [ "$package_dir" = /sdcard/temp/TempFirmware ]; then
            rm -f "$package_dir/.status" "$package_dir/.status.nextgen.tmp" ||
                return 1
        fi
    else
        if [ "$package_dir" = /sdcard/temp/TempFirmware ]; then
            status="$package_dir/.status"
            if [ -f "$package" ]; then
                # The download is still complete and verified; make it
                # deliberately retryable regardless of where power failed in
                # the previous applying-state update.
                printf 'ready:%s\n' "$cleanup_version" > "$package_dir/.status.nextgen.tmp" || return 1
                sync
                mv -f "$package_dir/.status.nextgen.tmp" "$status" || return 1
            else
                rm -f "$status" "$package_dir/.status.nextgen.tmp" || return 1
            fi
        fi
        # USB packages are retained after rollback for operator retry/removal.
    fi

    sync
    rm -f "$CLEANUP"
    [ "$outcome" != rollback ] || rm -f "$ROLLBACK"
    sync
    return 0
}

# The launcher decides rollback before /sdcard is available. Once the
# Application reaches measurement startup, repair the removable-media state.
if [ -f "$ROLLBACK" ]; then
    cleanup_download rollback || true
    rm -f "$BOOTING"
    exit 0
fi

if [ ! -f "$PENDING" ]; then
    rm -f "$BOOTING"

    # A power loss can occur after durable acceptance or rollback decision but
    # before package cleanup. Determine the outcome from the known-good marker.
    if [ -f "$CLEANUP" ]; then
        cleanup_version=
        cleanup_package=
        cleanup_extra=
        IFS=' ' read -r cleanup_version cleanup_package cleanup_extra < "$CLEANUP" ||
            true
        active="$(readlink "$APP_ROOT/active" 2>/dev/null || true)"
        accepted_line="$(cat "$ACCEPTED" 2>/dev/null || true)"
        if [ -n "$cleanup_version" ] &&
           [ "$accepted_line" = "$active $cleanup_version" ]; then
            cleanup_download accepted || true
        else
            cleanup_download rollback || true
        fi
    fi
    exit 0
fi

new=
old=
version=
extra=
IFS=' ' read -r new old version extra < "$PENDING" || exit 1
case "$new" in slotA|slotB) ;; *) exit 1 ;; esac
case "$old" in slotA|slotB|factory) ;; *) exit 1 ;; esac
case "$version" in ''|*[!0-9]*) exit 1 ;; esac
[ "$version" -gt 0 ] && [ "$version" -le 2147483647 ] || exit 1
[ -z "$extra" ] || exit 1

active="$(readlink "$APP_ROOT/active" 2>/dev/null || true)"
[ "$active" = "$new" ] || exit 1
[ "$(cat "$BOOTING" 2>/dev/null || true)" = "$new" ] || exit 1
slot_app_valid "$new" || exit 1
[ "$(slot_version "$new")" = "$version" ] || exit 1

# This is the authoritative acceptance point. It happens only after the new
# Application reached its measurement-started milestone.
printf '%s %s\n' "$new" "$version" > "$STATE_ROOT/.accepted.tmp"
sync
mv -f "$STATE_ROOT/.accepted.tmp" "$ACCEPTED"
sync

# Once acceptance is durable, rollback must never be inferred from a later
# storage-cleanup failure. Remove transient boot intent first; cleanup remains
# retryable through the durable cleanup record.
rm -f "$PENDING" "$BOOTING" "$ROLLBACK"
sync

cleanup_download accepted || true

echo "NextGen update: accepted $PRODUCT $new version $version"
