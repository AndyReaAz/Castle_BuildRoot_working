#!/bin/sh

USB_CONTROL=/opt/nextgen/platform/bin/usbcontrol.sh
PRODUCT="$(cat /etc/nextgen-product 2>/dev/null || echo sound)"
ENGMODE_FILE="/opt/nextgen/data/$PRODUCT/engmode"

start_gadget()
{
    # Normal production startup deliberately does nothing here.  Gadget
    # modules, configfs and function instances are created later by the
    # application only when its final runtime USB mask is non-zero.
    #
    # Engineering mode keeps an early NCM recovery path so the unit remains
    # reachable even if the application cannot progress far enough to request
    # its normal USB configuration.
    if [ -f "$ENGMODE_FILE" ] && [ -x "$USB_CONTROL" ]; then
        echo "Engineering recovery NCM: enabling usb0"
        "$USB_CONTROL" mask 2 || {
            echo "Failed to enable engineering recovery NCM"
            return 1
        }
    else
        echo "USB gadget deferred to application"
    fi
}

stop_gadget()
{
    if [ -x "$USB_CONTROL" ]; then
        "$USB_CONTROL" mask 0 >/dev/null 2>&1 || true
    fi
}

case "$1" in
    start)
        start_gadget
        ;;
    stop)
        stop_gadget
        ;;
    restart)
        stop_gadget
        start_gadget
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac
