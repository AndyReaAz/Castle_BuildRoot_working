#!/bin/sh
set -eu

TTY="${NEXTGEN_BRINGUP_TTY:-/dev/tty1}"
PROGRESS_STATE=/run/nextgen-bringup-screen.progress

wait_for_lcd()
{
    count=0
    while [ "$count" -lt 300 ]; do
        if [ -c "$TTY" ] && [ -e /sys/class/graphics/fb0 ]; then
            return 0
        fi
        sleep 0.1
        count=$((count + 1))
    done
    return 1
}

reset_progress_state()
{
    rm -f "$PROGRESS_STATE"
}

paint()
{
    sgr="$1"
    shift

    wait_for_lcd || return 1
    reset_progress_state

    {
        printf '\033[?25l'
        printf '\033[%sm' "$sgr"
        printf '\033[2J\033[H'
        printf '\n\n'
        while [ "$#" -gt 0 ]; do
            printf '   %s\n' "$1"
            shift
        done
    } > "$TTY"
}

progress()
{
    stage="$*"

    wait_for_lcd || return 1

    if [ ! -e "$PROGRESS_STATE" ]; then
        {
            printf '\033[?25l'
            printf '\033[37;40m'
            printf '\033[2J\033[H'
            printf '\n'
            printf '   NEXTGEN BRING-UP\n'
            printf '\n'
            printf '   %s\n' "$stage"
        } > "$TTY"
        : > "$PROGRESS_STATE"
    else
        # Keep previous stages visible. fbcon scrolls naturally when the LCD
        # runs out of text rows; success/failure repaint the whole screen.
        printf '   %s\n' "$stage" > "$TTY"
    fi
}

case "${1:-}" in
    progress)
        shift
        [ "$#" -gt 0 ] || {
            echo "Usage: $0 progress <stage>" >&2
            exit 2
        }
        progress "$@"
        ;;
    success)
        shift
        paint '30;42' "$@"
        ;;
    fail)
        shift
        paint '37;41' "$@"
        ;;
    hold)
        shift
        paint '30;43' "$@"
        ;;
    clear)
        paint '37;40' ''
        ;;
    *)
        echo "Usage: $0 {progress|success|fail|hold|clear} [message ...]" >&2
        exit 2
        ;;
esac
