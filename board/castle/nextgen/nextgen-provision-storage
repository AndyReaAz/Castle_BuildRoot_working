#!/bin/sh
set -u

BUNDLE=/opt/nextgen/provision
ARM_MARKER=/etc/nextgen-provision-armed
TMP=/tmp/nextgen-provision
UBOOT_TRAILER_OFFSET=$((0x137ff0))

log()
{
    echo "BRINGUP: $*"
}

not_armed()
{
    log "production storage programming is not armed in this build"
    return 64
}

fail()
{
    log "storage provisioning failed: $*" >&2
    return 1
}

mtd_line()
{
    label="$1"
    grep " \"$label\"$" /proc/mtd 2>/dev/null | head -n 1
}

mtd_by_label()
{
    line="$(mtd_line "$1")"
    [ -n "$line" ] || return 1
    name="${line%%:*}"
    printf '/dev/%s\n' "$name"
}

mtd_size_hex()
{
    line="$(mtd_line "$1")"
    [ -n "$line" ] || return 1
    set -- $line
    printf '%s\n' "$2"
}

require_mtd_size()
{
    label="$1"
    expected="$2"
    got="$(mtd_size_hex "$label")" || {
        fail "missing MTD partition: $label"
        return 1
    }
    [ "$((0x$got))" -eq "$((expected))" ] || {
        fail "$label size mismatch: 0x$got != $(printf '0x%x' "$expected")"
        return 1
    }
}

hash_file()
{
    sha256sum "$1" | awk '{print $1}'
}

verify_readback()
{
    dev="$1"
    offset="$2"
    source="$3"
    name="$4"
    bytes="$(wc -c < "$source" | tr -d '[:space:]')"
    out="$TMP/$name.readback"

    rm -f "$out"
    mtd_debug read "$dev" "$offset" "$bytes" "$out" >/dev/null || {
        fail "could not read back $name"
        return 1
    }

    [ "$(hash_file "$source")" = "$(hash_file "$out")" ] || {
        fail "$name readback hash mismatch"
        return 1
    }
}

find_ubi_for_mtd()
{
    mtddev="$1"
    mtdnum="${mtddev#/dev/mtd}"
    for p in /sys/class/ubi/ubi[0-9]*
    do
        case "$(basename "$p")" in
            ubi[0-9]*) ;;
            *) continue ;;
        esac
        [ -f "$p/mtd_num" ] || continue
        [ "$(cat "$p/mtd_num")" = "$mtdnum" ] || continue
        basename "$p"
        return 0
    done
    return 1
}

find_ubi_volume()
{
    ubidev="$1"
    wanted="$2"

    for p in "/sys/class/ubi/$ubidev"_[0-9]*
    do
        [ -f "$p/name" ] || continue
        [ "$(cat "$p/name")" = "$wanted" ] || continue
        printf '/dev/%s\n' "$(basename "$p")"
        return 0
    done
    return 1
}

ubi_data_bytes()
{
    volume="$1"
    sys="/sys/class/ubi/$(basename "$volume")/data_bytes"
    [ -r "$sys" ] || return 1
    cat "$sys"
}

detach_if_attached()
{
    mtddev="$1"
    ubidetach -p "$mtddev" >/dev/null 2>&1 || true
}

verify_boot_ubi()
{
    bootdev="$1"

    ubiattach -p "$bootdev" >/dev/null || {
        fail "could not attach programmed boot UBI"
        return 1
    }
    ubidev="$(find_ubi_for_mtd "$bootdev")" || {
        fail "could not identify attached boot UBI device"
        detach_if_attached "$bootdev"
        return 1
    }

    dtvol="$(find_ubi_volume "$ubidev" device-tree)" || {
        fail "boot UBI has no device-tree volume"
        detach_if_attached "$bootdev"
        return 1
    }
    krnlvol="$(find_ubi_volume "$ubidev" kernel)" || {
        fail "boot UBI has no kernel volume"
        detach_if_attached "$bootdev"
        return 1
    }

    dtbytes="$(ubi_data_bytes "$dtvol" 2>/dev/null || echo 0)"
    krnlbytes="$(ubi_data_bytes "$krnlvol" 2>/dev/null || echo 0)"
    [ "$dtbytes" -gt 0 ] && [ "$krnlbytes" -gt 0 ] || {
        fail "boot UBI contains empty static volume"
        detach_if_attached "$bootdev"
        return 1
    }

    detach_if_attached "$bootdev"
}

verify_root_ubi()
{
    rootdev="$1"
    product="$2"
    system_mount="$TMP/system"
    persist_mount="$TMP/persist"

    ubiattach -p "$rootdev" >/dev/null || {
        fail "could not attach programmed rootfs UBI"
        return 1
    }
    ubidev="$(find_ubi_for_mtd "$rootdev")" || {
        fail "could not identify attached rootfs UBI device"
        detach_if_attached "$rootdev"
        return 1
    }

    systemvol="$(find_ubi_volume "$ubidev" system)" || {
        fail "rootfs UBI has no system volume"
        detach_if_attached "$rootdev"
        return 1
    }
    persistvol="$(find_ubi_volume "$ubidev" persist)" || {
        fail "rootfs UBI has no persist volume"
        detach_if_attached "$rootdev"
        return 1
    }

    blockdev="/dev/ubiblock${systemvol#/dev/ubi}"
    ubiblock --create "$systemvol" >/dev/null || {
        fail "could not create ubiblock for system volume"
        detach_if_attached "$rootdev"
        return 1
    }

    mkdir -p "$system_mount" "$persist_mount"
    rc=0

    mount -t squashfs -o ro "$blockdev" "$system_mount" || rc=1
    if [ "$rc" -eq 0 ]; then
        [ "$(cat "$system_mount/etc/nextgen-storage-schema" 2>/dev/null || true)" = "ro-persist-v1" ] || rc=1
        [ "$(cat "$system_mount/etc/nextgen-storage-backend" 2>/dev/null || true)" = "nand-ubi" ] || rc=1
        [ -f "$system_mount/etc/nextgen-sd-data-only" ] || rc=1
        [ "$(cat "$system_mount/etc/nextgen-product" 2>/dev/null || true)" = "$product" ] || rc=1
    fi

    mount -t ubifs "$persistvol" "$persist_mount" || rc=1
    if [ "$rc" -eq 0 ] && mountpoint -q "$persist_mount"; then
        [ -s "$persist_mount/app/$product/slotA.sqfs" ] || rc=1
        [ -s "$persist_mount/app/$product/slotA.meta" ] || rc=1
        accepted="$(cat "$persist_mount/state/$product/accepted" 2>/dev/null || true)"
        case "$accepted" in
            "slotA "*) ;;
            *) rc=1 ;;
        esac
    fi

    mountpoint -q "$persist_mount" && umount "$persist_mount" || true
    mountpoint -q "$system_mount" && umount "$system_mount" || true
    ubiblock --remove "$systemvol" >/dev/null 2>&1 || rc=1
    detach_if_attached "$rootdev"

    [ "$rc" -eq 0 ] || {
        fail "programmed RO system/persist UBI failed content verification"
        return 1
    }
}

main()
{
    [ -f "$ARM_MARKER" ] || {
        not_armed
        return $?
    }

    for cmd in         sha256sum awk grep head wc tr         flash_erase mtd_debug ubiformat ubiattach ubidetach ubiblock         mount umount mountpoint
    do
        command -v "$cmd" >/dev/null 2>&1 || {
            fail "required command is unavailable: $cmd"
            return 1
        }
    done

    [ -d "$BUNDLE" ] || {
        fail "production provisioning bundle is missing"
        return 1
    }
    [ -r "$BUNDLE/manifest.sha256" ] || {
        fail "production provisioning manifest is missing"
        return 1
    }

    (
        cd "$BUNDLE" &&
        sha256sum -c manifest.sha256
    ) >/dev/null || {
        fail "production provisioning bundle hash verification failed"
        return 1
    }

    . "$BUNDLE/layout.env"
    [ "${NEXTGEN_PROVISION_BUNDLE:-}" = "2" ] || {
        fail "invalid provisioning bundle format"
        return 1
    }
    [ "${NEXTGEN_STORAGE_SCHEMA:-}" = "ro-persist-v1" ] || {
        fail "unexpected production storage schema"
        return 1
    }
    [ "${NEXTGEN_STORAGE_BACKEND:-}" = "nand-ubi" ] || {
        fail "unexpected production storage backend"
        return 1
    }
    case "${NEXTGEN_PRODUCT:-}" in sound|vibra) ;; *)
        fail "invalid production product"
        return 1
        ;;
    esac

    require_mtd_size at91bootstrap "$((0x00008000))" || return 1
    require_mtd_size uboot "$((0x00138000))" || return 1
    require_mtd_size uboot-env "$((0x00020000))" || return 1
    require_mtd_size boot "$((0x00880000))" || return 1
    require_mtd_size rootfs "$((0x08000000))" || return 1

    [ "${NOR_UBOOT_TRAILER_OFFSET:-}" = "0x00137ff0" ] || {
        fail "unexpected U-Boot trailer offset in bundle"
        return 1
    }

    at91dev="$(mtd_by_label at91bootstrap)" || return 1
    ubootdev="$(mtd_by_label uboot)" || return 1
    envdev="$(mtd_by_label uboot-env)" || return 1
    bootdev="$(mtd_by_label boot)" || return 1
    rootdev="$(mtd_by_label rootfs)" || return 1

    rm -rf "$TMP"
    mkdir -p "$TMP"

    # Program and prove both NAND UBI devices first. Until NOR is changed the
    # existing boot chain and the service SD card remain recoverable.
    log "formatting production NAND system/persist UBI"
    detach_if_attached "$rootdev"
    ubiformat "$rootdev" -y -f "$BUNDLE/rootfs.ubi" || {
        fail "ubiformat failed for rootfs"
        return 1
    }
    verify_root_ubi "$rootdev" "$NEXTGEN_PRODUCT" || return 1

    log "formatting production NAND boot UBI"
    detach_if_attached "$bootdev"
    ubiformat "$bootdev" -y -f "$BUNDLE/boot.ubi" || {
        fail "ubiformat failed for boot"
        return 1
    }
    verify_boot_ubi "$bootdev" || return 1

    # Replace U-Boot while the old fixed-window bootstrap can still load it.
    log "programming NOR U-Boot"
    flash_erase "$ubootdev" 0 0 >/dev/null || {
        fail "could not erase U-Boot partition"
        return 1
    }
    uboot_bytes="$(wc -c < "$BUNDLE/u-boot.bin" | tr -d '[:space:]')"
    [ "$uboot_bytes" -le $((0x0a0000)) ] || {
        fail "U-Boot exceeds migration-safe 640 KiB window"
        return 1
    }
    mtd_debug write "$ubootdev" 0 "$uboot_bytes" "$BUNDLE/u-boot.bin" >/dev/null || {
        fail "could not program U-Boot"
        return 1
    }
    mtd_debug write "$ubootdev" "$UBOOT_TRAILER_OFFSET" 16 "$BUNDLE/u-boot.trailer" >/dev/null || {
        fail "could not program U-Boot length trailer"
        return 1
    }
    verify_readback "$ubootdev" 0 "$BUNDLE/u-boot.bin" u-boot || return 1
    verify_readback "$ubootdev" "$UBOOT_TRAILER_OFFSET" "$BUNDLE/u-boot.trailer" u-boot-trailer || return 1

    # Remove legacy/test environment. Production defaults are compiled into
    # U-Boot; factory identity can establish redundant copies afterwards.
    log "erasing NOR U-Boot environment"
    flash_erase "$envdev" 0 0 >/dev/null || {
        fail "could not erase U-Boot environment"
        return 1
    }

    # Bootstrap is last: only after NAND and U-Boot are proved do we switch ROM
    # to the trailer-aware/fuse-guarded production bootstrap.
    log "programming NOR AT91Bootstrap"
    flash_erase "$at91dev" 0 0 >/dev/null || {
        fail "could not erase AT91Bootstrap partition"
        return 1
    }
    at91_bytes="$(wc -c < "$BUNDLE/at91bootstrap.bin" | tr -d '[:space:]')"
    [ "$at91_bytes" -le $((0x8000)) ] || {
        fail "AT91Bootstrap exceeds 32 KiB partition"
        return 1
    }
    mtd_debug write "$at91dev" 0 "$at91_bytes" "$BUNDLE/at91bootstrap.bin" >/dev/null || {
        fail "could not program AT91Bootstrap"
        return 1
    }
    verify_readback "$at91dev" 0 "$BUNDLE/at91bootstrap.bin" at91bootstrap || return 1

    sync
    log "production storage programming and readback verification complete"
    return 0
}

main
exit $?
