loadaddr=0x22000000
krnladdr=0x23000000
bootcmd=setenv bootargs console=ttyS0,576000 quiet loglevel=3 consoleblank=0 vt.global_cursor_default=0 root=/dev/mmcblk0p2 rw rootwait nextgen.env=bringup nextgen.manufacturer=${manufacturer} nextgen.modeltype=${modeltype} nextgen.model=${model}; fatload mmc 0:1 ${loadaddr} nextgen.dtb; fatload mmc 0:1 ${krnladdr} zImage; bootz ${krnladdr} - ${loadaddr}
bootdelay=-2
silent=1
manufacturer=castle
modeltype=0
model=0

baudrate=576000
