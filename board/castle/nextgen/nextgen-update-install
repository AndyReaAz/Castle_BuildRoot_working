#!/bin/sh
set -eu

die()
{
    echo "NextGen update: $*" >&2
    exit 1
}

[ "$#" -eq 2 ] || {
    echo "Usage: $0 <sound|vibra> <package.zip>" >&2
    exit 2
}

PRODUCT="$1"
PACKAGE="$2"
case "$PRODUCT" in sound|vibra) ;; *) die "invalid product '$PRODUCT'" ;; esac
[ -f "$PACKAGE" ] || die "package not found: $PACKAGE"
[ ! -L "$PACKAGE" ] || die "package must not be a symlink"
PACKAGE_BYTES="$(wc -c < "$PACKAGE")"
[ "$PACKAGE_BYTES" -le $((140 * 1024 * 1024)) ] ||
    die "package exceeds 140 MiB archive limit"

SDCARD_ROOT="${NEXTGEN_SDCARD_ROOT:-/sdcard}"
PACKAGE_DIR="$(dirname "$PACKAGE")"
PACKAGE_NAME="${PACKAGE##*/}"
case "$PACKAGE_DIR" in
    "$SDCARD_ROOT/public"|"$SDCARD_ROOT/temp/TempFirmware") ;;
    *) die "update package is outside an approved staging directory" ;;
esac
case "$PACKAGE_NAME" in
    ''|*[!A-Za-z0-9_.-]*|*.part) die "invalid update package name: $PACKAGE_NAME" ;;
esac
case "$PACKAGE_NAME" in *.zip) ;; *) die "update package is not a ZIP" ;; esac

# Production defaults remain fixed; host-side tests override these roots.
ROOT="${NEXTGEN_ROOT:-/opt/nextgen}"
RUN_ROOT="${NEXTGEN_RUN_ROOT:-/run}"
APP_ROOT="$ROOT/app/$PRODUCT"
STATE_ROOT="$ROOT/state/$PRODUCT"
MEMBERS="$STATE_ROOT/.members.tmp"
MANIFEST_TMP="$STATE_ROOT/.manifest.tmp"
TARGETS="$STATE_ROOT/.targets.tmp"
ENTRIES="$STATE_ROOT/.entries.tmp"
SIG_TMP="$STATE_ROOT/.manifest-signature.tmp"
PUBLIC_KEY="$ROOT/platform/share/update-public.pem"
SIGNING_POLICY="$ROOT/platform/share/update-signing-policy"
STAGE=
LOCK="$RUN_ROOT/nextgen-update-$PRODUCT.lock"

cleanup()
{
    rm -f "$MEMBERS" "$MANIFEST_TMP" "$TARGETS" "$ENTRIES" "$SIG_TMP" \
        "$STATE_ROOT/.pending.tmp" "$STATE_ROOT/.cleanup.tmp"
    [ -z "$STAGE" ] || rm -rf "$STAGE"
    rmdir "$LOCK" 2>/dev/null || true
}

mkdir -p "$APP_ROOT" "$STATE_ROOT" "$RUN_ROOT"
if ! mkdir "$LOCK" 2>/dev/null; then
    die "another application install is already in progress"
fi
trap cleanup EXIT INT TERM

for state in pending booting rollback cleanup; do
    [ ! -e "$STATE_ROOT/$state" ] ||
        die "previous update transaction still needs recovery/cleanup"
done

rm -f "$MEMBERS" "$MANIFEST_TMP" "$TARGETS" "$ENTRIES" "$SIG_TMP" \
    "$STATE_ROOT/.pending.tmp" "$STATE_ROOT/.cleanup.tmp"
: > "$TARGETS"

unzip -Z1 "$PACKAGE" > "$MEMBERS" || die "cannot read package directory"

member_count=0
manifest_count=0
signature_count=0
manifest_name=
while IFS= read -r member; do
    [ -n "$member" ] || die "empty archive member"
    case "$member" in
        */*|*\\*|*[!A-Za-z0-9_.-]*) die "invalid archive member: $member" ;;
        [A-Za-z0-9]*) ;;
        *) die "archive member must start alphanumeric: $member" ;;
    esac
    member_count=$((member_count + 1))
    [ "$member_count" -le 130 ] || die "too many archive members"
    case "$member" in
        manifest_V*_*.txt)
            manifest_count=$((manifest_count + 1))
            manifest_name="$member"
            ;;
        manifest.sig)
            signature_count=$((signature_count + 1))
            ;;
    esac
done < "$MEMBERS"

[ "$manifest_count" -eq 1 ] || die "package must contain exactly one manifest"
unzip -p "$PACKAGE" "$manifest_name" > "$MANIFEST_TMP" ||
    die "cannot extract manifest"
[ "$(wc -c < "$MANIFEST_TMP")" -le $((64 * 1024)) ] ||
    die "manifest exceeds 64 KiB limit"

digest_from_name()
{
    base="$1"
    stem="${base%.*}"
    expected="${stem##*_}"
    [ "${#expected}" -eq 32 ] || return 1
    case "$expected" in *[!0-9A-Fa-f]*) return 1 ;; esac
    printf '%s\n' "$expected" | tr 'A-F' 'a-f'
}

manifest_md5="$(digest_from_name "$manifest_name")" ||
    die "manifest filename has no valid digest"
actual_md5="$(md5sum "$MANIFEST_TMP" | awk '{print $1}')"
[ "$manifest_md5" = "$actual_md5" ] || die "manifest digest mismatch"

policy="$(cat "$SIGNING_POLICY" 2>/dev/null || true)"
case "$policy" in
    ed25519-required)
        [ -r "$PUBLIC_KEY" ] || die "signed-update policy has no public key"
        [ "$signature_count" -eq 1 ] || die "signed bundle requires exactly one manifest.sig"
        unzip -p "$PACKAGE" manifest.sig > "$SIG_TMP" ||
            die "cannot extract manifest signature"
        [ "$(wc -c < "$SIG_TMP")" -eq 64 ] ||
            die "invalid Ed25519 signature length"
        openssl pkeyutl -verify -pubin -inkey "$PUBLIC_KEY" -rawin \
            -in "$MANIFEST_TMP" -sigfile "$SIG_TMP" >/dev/null 2>&1 ||
            die "manifest signature verification failed"
        ;;
    unsigned-development)
        [ "$signature_count" -eq 0 ] ||
            die "signed bundle cannot be verified by this development image"
        echo "NextGen update: WARNING accepting unsigned development bundle" >&2
        ;;
    *)
        die "missing or invalid update signing policy"
        ;;
esac

magic=
format=
bundle_product=
version=
extra=
IFS=' ' read -r magic format bundle_product version extra < "$MANIFEST_TMP" ||
    die "cannot read manifest header"
[ "$magic" = "NEXTGEN_APP_BUNDLE" ] || die "unsupported manifest"
[ "$format" = "3" ] || die "unsupported bundle format $format"
[ "$bundle_product" = "$PRODUCT" ] || die "bundle is for $bundle_product, not $PRODUCT"
case "$version" in ''|*[!0-9]*) die "invalid bundle version" ;; esac
[ "$version" -gt 0 ] && [ "$version" -le 2147483647 ] ||
    die "invalid bundle version"
[ -z "$extra" ] || die "invalid manifest header"

ACTIVE="$(readlink "$APP_ROOT/active" 2>/dev/null || true)"
case "$ACTIVE" in
    slotA) OLD=slotA; NEW=slotB ;;
    slotB) OLD=slotB; NEW=slotA ;;
    factory) OLD=factory; NEW=slotA ;;
    *) die "active application slot is not initialised" ;;
esac

ACTIVE_INFO="$APP_ROOT/$ACTIVE/bundle.info"
[ -r "$ACTIVE_INFO" ] || die "active slot has no bundle metadata"
current_format="$(sed -n 's/^format=//p' "$ACTIVE_INFO")"
current_product="$(sed -n 's/^product=//p' "$ACTIVE_INFO")"
current_version="$(sed -n 's/^version=//p' "$ACTIVE_INFO")"
[ "$current_format" = 3 ] || die "active slot has unsupported bundle format"
[ "$current_product" = "$PRODUCT" ] || die "active slot product metadata mismatch"
case "$current_version" in ''|*[!0-9]*) die "active slot has invalid version metadata" ;; esac
[ "$current_version" -gt 0 ] && [ "$current_version" -le 2147483647 ] ||
    die "active slot has invalid version metadata"
[ "$version" -gt "$current_version" ] ||
    die "bundle version $version is not newer than active version $current_version"

STAGE="$APP_ROOT/.$NEW.staging"
rm -rf "$STAGE"
mkdir -p "$STAGE"

valid_target()
{
    value="$1"
    [ "${#value}" -le 200 ] || return 1
    case "$value" in
        ''|/*|*\\*|*//*|*[!A-Za-z0-9_./-]*|bundle.info) return 1 ;;
    esac
    oldifs="$IFS"
    IFS='/'
    set -- $value
    IFS="$oldifs"
    [ "$#" -ge 1 ] && [ "$#" -le 4 ] || return 1
    for part in "$@"; do
        [ -n "$part" ] && [ "$part" != "." ] && [ "$part" != ".." ] &&
            [ "${#part}" -le 100 ] || return 1
        case "$part" in [A-Za-z0-9]*) ;; *) return 1 ;; esac
    done
    return 0
}

sed '1d' "$MANIFEST_TMP" > "$ENTRIES"
total_payload_bytes=0
while IFS=' ' read -r source target mode expected_sha256 extra_line; do
    [ -n "$source" ] || die "empty manifest entry"
    [ -z "$extra_line" ] || die "invalid manifest entry"
    [ "${#expected_sha256}" -eq 64 ] || die "invalid SHA-256 in manifest"
    case "$expected_sha256" in *[!0-9A-Fa-f]*) die "invalid SHA-256 in manifest" ;; esac
    expected_sha256="$(printf '%s' "$expected_sha256" | tr 'A-F' 'a-f')"
    case "$source" in
        */*|*\\*|*[!A-Za-z0-9_.-]*) die "invalid source member: $source" ;;
        [A-Za-z0-9]*) ;;
        *) die "source member must start alphanumeric: $source" ;;
    esac
    valid_target "$target" || die "invalid slot target: $target"
    case "$mode" in 0644|0755) ;; *) die "invalid target mode: $mode" ;; esac

    [ "$(grep -Fxc "$source" "$MEMBERS")" -eq 1 ] ||
        die "manifest member missing or duplicated: $source"
    if grep -Fqx "$target" "$TARGETS"; then
        die "duplicate slot target: $target"
    fi
    printf '%s\n' "$target" >> "$TARGETS"

    expected="$(digest_from_name "$source")" ||
        die "payload filename has no valid digest: $source"

    dest="$STAGE/$target"
    mkdir -p "$(dirname "$dest")"
    unzip -p "$PACKAGE" "$source" > "$dest.tmp" ||
        die "cannot extract $source"
    actual="$(md5sum "$dest.tmp" | awk '{print $1}')"
    [ "$actual" = "$expected" ] || die "payload MD5 envelope mismatch: $source"
    actual_sha256="$(sha256sum "$dest.tmp" | awk '{print $1}')"
    [ "$actual_sha256" = "$expected_sha256" ] ||
        die "payload SHA-256 mismatch: $source"

    payload_bytes="$(wc -c < "$dest.tmp")"
    total_payload_bytes=$((total_payload_bytes + payload_bytes))
    [ "$total_payload_bytes" -le $((128 * 1024 * 1024)) ] ||
        die "uncompressed bundle exceeds 128 MiB"

    chmod "$mode" "$dest.tmp"
    mv -f "$dest.tmp" "$dest"
done < "$ENTRIES"
entry_count="$(($(wc -l < "$MANIFEST_TMP") - 1))"
[ "$entry_count" -ge 2 ] || die "bundle has too few payloads"
[ "$((entry_count + 1 + signature_count))" -eq "$member_count" ] ||
    die "archive contains files not declared by the manifest"
[ -x "$STAGE/NextGen" ] || die "bundle has no executable NextGen"
[ -r "$STAGE/Translations.csv" ] || die "bundle has no Translations.csv"
if [ "$PRODUCT" = sound ]; then
    [ -r "$STAGE/BaseHPD/hpdc.csv" ] || die "sound bundle has no HPD database"
fi


cat > "$STAGE/bundle.info" <<EOF
format=3
product=$PRODUCT
version=$version
EOF

sync

# Before recycling the inactive slot, make every fallback pointer refer to the
# currently active known-good release. This prevents a power cut during slot
# replacement from leaving "previous" pointing at an unaccepted candidate.
rm -f "$APP_ROOT/.previous.tmp"
ln -s "$OLD" "$APP_ROOT/.previous.tmp" ||
    die "cannot prepare previous-slot link"
mv -Tf "$APP_ROOT/.previous.tmp" "$APP_ROOT/previous" ||
    die "cannot publish previous-slot link"
sync

# Publish the completed inactive slot as one same-filesystem directory rename.
# A loss of power before this point cannot affect the active application.
rm -rf "$APP_ROOT/$NEW"
mv "$STAGE" "$APP_ROOT/$NEW"
STAGE=
sync

# Record the complete staged transaction durably. The running application keeps
# using the old active slot; the platform launcher performs the single active
# symlink switch on the following reboot. Keep the existing accepted marker:
# it is proof that OLD is known-good and cannot match NEW+version because
# routine updates are strictly monotonic.
rm -f "$STATE_ROOT/booting" "$STATE_ROOT/rollback"
sync

printf '%s %s\n' "$version" "$PACKAGE" > "$STATE_ROOT/.cleanup.tmp"
sync
mv -f "$STATE_ROOT/.cleanup.tmp" "$STATE_ROOT/cleanup"

printf '%s %s %s\n' "$NEW" "$OLD" "$version" > "$STATE_ROOT/.pending.tmp"
sync
mv -f "$STATE_ROOT/.pending.tmp" "$STATE_ROOT/pending"
sync

echo "NextGen update: staged $PRODUCT version $version in $NEW; reboot required"
